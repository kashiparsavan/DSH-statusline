{
  "name": "@local/dsh-statusbar",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A living status line for DeepSeek Harness: a breathing terminal strip under the composer, and a model ribbon in the session header that flags when a model's name and its serving route disagree.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "statusline",
    "statusline-plugin",
    "dsh-bundle",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/kashiparsavan/DSH-statusline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kashiparsavan/DSH-statusline.git"
  },
  "bugs": {
    "url": "https://github.com/kashiparsavan/DSH-statusline/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "styles/*.css",
    "scripts/*.mjs",
    "docs/*.md",
    "install.ps1",
    "install.cmd",
    "update.cmd",
    "uninstall.ps1",
    "uninstall.cmd",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check client.src.js && node --check client.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
